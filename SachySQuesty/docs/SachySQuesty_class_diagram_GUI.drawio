<mxCell id="tV" value="grafické uživatelské rozhraní – vykresluje okna a jejich obsah (tkinter)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontStyle=2;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="104" y="23" width="520" height="20" as="geometry"/></mxCell>
<mxCell id="tC" value="zpracování uživatelských událostí – reaguje na události systému, volá Model a aktualizuje View" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontStyle=2;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="440" y="860" width="210" height="92" as="geometry"/></mxCell>
<mxCell id="tM" value="šedé třídy = model a pomocné třídy (utils); uvedeny jen členy, které používá GUI vrstva" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontStyle=2;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="1625" width="700" height="24" as="geometry"/></mxCell>
<mxCell id="note1" value="&lt;b&gt;Pravidla MVC v ŠachySQuesty&lt;/b&gt;&lt;br&gt;• View (tkinter) jen vykresluje – Model nezná,&lt;br&gt;   data mu předává Controller.&lt;br&gt;• Controller zpracovává události systému:&lt;br&gt;   klik na desku &amp;lt;Button-1&amp;gt; → klik_na_desku()&lt;br&gt;   tlačítka (command=…) → metody controlleru&lt;br&gt;   časovač okno.after(1000) → tik_casovace()&lt;br&gt;   LAN zprávy okno.after(100) → _zpracuj_lan()&lt;br&gt;   zavření okna WM_DELETE_WINDOW → ukonci()&lt;br&gt;• Model neví o View ani o Controlleru.&lt;br&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="1450" width="400" height="168" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>